# Copy this file to .env and fill in values as needed.
# No secrets are required for the pilot's public-data collection.
# This file exists so future stages (e.g. an API-based translation
# service, or a hosted database) have a documented place to put
# credentials, without ever committing real ones.

# Optional: override the default collector user agent
# USER_AGENT="nordic-ai-policy-tracker/0.1 (+mailto:you@example.com)"

# Optional: override default request delay (seconds) between collections
# REQUEST_DELAY_SECONDS=3

# Optional: path override for the SQLite database
# DATABASE_PATH=data/processed/policy_tracker.db
